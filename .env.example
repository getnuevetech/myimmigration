# PostgreSQL connection
DATABASE_URL="postgresql://myimmigration:myimmigration_dev_password@localhost:5432/myimmigration?schema=public"

# Optional: override the session signing secret (otherwise auto-generated and stored in the settings table)
# AUTH_SECRET=

# Optional: shared secret for authenticated /api/health maintenance (daily cron Bearer token)
# CRON_SECRET=

# Optional: initial super-admin credentials used by `prisma db seed`
# SEED_ADMIN_EMAIL=admin@immigrationonme.com
# SEED_ADMIN_PASSWORD=ChangeMe!2026
