# --- Core runtime ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Credentials used by the postgres docker container.
POSTGRES_USER=myimmigration
POSTGRES_PASSWORD=myimmigration
# Same password, URL-encoded for Prisma connection strings.
# Example: "abc@2007" becomes "abc%402007".
POSTGRES_PASSWORD_URL_ENCODED=myimmigration
POSTGRES_DB=myimmigration
# Used by local Prisma commands outside Docker. Docker Compose builds the
# app container's DATABASE_URL from POSTGRES_USER, POSTGRES_DB, and
# POSTGRES_PASSWORD_URL_ENCODED.
DATABASE_URL=postgresql://myimmigration:myimmigration@db:5432/myimmigration?schema=public

# --- Authentication / sessions (Phase A scaffold) ---
AUTH_SESSION_SECRET=replace-with-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI fallback provider ---
# Can be set here OR in /admin/platform-settings
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Optional OpenAI fallback overrides for staged orchestration
OPENAI_FALLBACK_MODEL_SUMMARY=gpt-4o
OPENAI_FALLBACK_MODEL_GOAL=gpt-4o
OPENAI_FALLBACK_MODEL_DOCUMENT=gpt-4o
OPENAI_FALLBACK_MODEL_SITUATION=gpt-4o
OPENAI_FALLBACK_MODEL_PRESENTATION=gpt-4o

# Anthropic (Claude) — used for FACT_EXTRACTOR and INTERPRETER roles
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-5

# Google AI (Gemini) — used for VERIFIER roles
GOOGLE_AI_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-1.5-pro

# --- Payments (configured in admin backend; keep blank in code) ---
PAYMENT_WEBHOOK_SECRET=

# --- Admin preview shell ---
ADMIN_PREVIEW_ENABLED=false
