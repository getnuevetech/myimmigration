# Copy to .env.deploy and edit before running:  docker compose --env-file .env.deploy up -d --build

# PostgreSQL (stored in the myimmigration_pgdata volume)
# Any characters are fine in the password; if it contains a dollar sign ($),
# wrap the value in single quotes so Docker Compose doesn't try to expand it.
POSTGRES_USER=myimmigration
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=myimmigration

# Port the app is exposed on
APP_PORT=3000

# Session signing secret (optional — auto-generated and stored in the DB if empty)
AUTH_SECRET=

# Shared secret for daily maintenance via /api/health (host crontab Bearer token).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Initial super-admin account created on first start (change the password after first login)
SEED_ADMIN_EMAIL=admin@immigrationonme.com
SEED_ADMIN_PASSWORD=change-this-admin-password
